<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../CityCommunicationCenter.Application/CityCommunicationCenter.Application.csproj" />
    <ProjectReference Include="../CityCommunicationCenter.Domain/CityCommunicationCenter.Domain.csproj" />
    <ProjectReference Include="../CityCommunicationCenter.Shared/CityCommunicationCenter.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- SMS numara normalizasyonu / endpoint allow-list gibi internal saf mantık test edilebilsin. -->
    <InternalsVisibleTo Include="CityCommunicationCenter.Application.Tests" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.7" />
    <!-- Lisans servisinin Ed25519/EdDSA imza doğrulaması için (System.Security.Cryptography'de yok). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <!-- NAS bağlantı testinde gerçek SMB/CIFS kimlik doğrulama + klasör oluşturma için (.NET'te native SMB istemcisi yok). -->
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

</Project>
